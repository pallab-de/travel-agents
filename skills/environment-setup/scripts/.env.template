# Copy this file to secrets/.env in YOUR project folder (not this plugin's folder), fill in the values you
# have, then run encrypt_env.py. Only add the keys you actually need for this run — leave the rest blank.

# Required for listing-search, place-matching, drive times (staycation-finder), and venue-verification
# (vacation-planner). Get one at https://console.cloud.google.com/ -> APIs & Services -> Credentials, and
# enable "Places API", "Distance Matrix API" and "Geocoding API" on it.
GOOGLE_MAPS_API_KEY=

# Optional: a licensed review provider, only if requirements-intake confirmed it is authorized (the free
# Google Places API caps out around 10 reviews per place). Token from https://apify.com.
APIFY_TOKEN=

# Optional, recommended for any trip with a flight: Google Flights fares/schedules and 20+ Google Maps reviews
# per place. Key from https://serpapi.com/manage-api-key. Verify with credential_status.py --verify.
SERPAPI_API_KEY=

# Optional: only used by vacation-planner's venue-verification skill (check_distance.py --provider ors) as
# an alternative to Google's Distance Matrix. Get one free at https://openrouteservice.org/dev/#/signup.
OPENROUTESERVICE_API_KEY=
